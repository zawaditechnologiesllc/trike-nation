# Port Render injects automatically; local default 4000.
PORT=4000

# Supabase project (Settings → API). Leave unset for demo mode (bundled
# catalog, simulated orders).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Comma-separated allowed origins for CORS (your Vercel URL). * allows all.
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000
