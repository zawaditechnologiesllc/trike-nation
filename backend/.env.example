# Port (Render injects PORT automatically; local default 4000).
PORT=4000

# Public URL of the Cloudflare Workers frontend — used for payment redirects,
# order links in emails, and the account-signup invitation link.
FRONTEND_URL=https://gocartgrip.shop

# Comma-separated allowed origins for CORS.
CORS_ORIGIN=https://gocartgrip.shop,https://www.gocartgrip.shop,http://localhost:3000

# Branding used in emails and the admin System page.
BRAND_NAME=Go Cart Grip
BRAND_DOMAIN=gocartgrip.shop

# --- Supabase (required) — Settings → API ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified domain/sender in Resend.
EMAIL_FROM=Go Cart Grip <orders@gocartgrip.shop>
EMAIL_REPLY_TO=support@gocartgrip.shop
# Receives contact-form messages and "new order awaiting confirmation" alerts.
ADMIN_EMAIL=admin@gocartgrip.shop
SUPPORT_EMAIL=support@gocartgrip.shop

# --- Stripe (hosted Checkout; NO webhooks) ---
# Payments are confirmed by an admin in /admin/orders, so there is no
# STRIPE_WEBHOOK_SECRET and no webhook endpoint to register.
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Optional, only if you later render Stripe Elements in the browser.
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxx
STRIPE_CURRENCY=usd

# --- Delivery updates cron ---
# Shared secret the Cloudflare cron Worker presents to /api/cron/*.
CRON_SECRET=generate-a-long-random-string
# Days after confirmed payment at which customers get a progress email.
DELIVERY_UPDATE_DAYS=7,12,20
DELIVERY_MIN_DAYS=12
DELIVERY_MAX_DAYS=30
# Sweep from inside this process instead of the Worker (single instance only).
ENABLE_INTERNAL_CRON=false

# --- Product images ---
# One year. Uploads are timestamped, so each image URL is immutable.
IMAGE_CACHE_SECONDS=31536000
