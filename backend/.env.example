# Port (Render injects PORT automatically; local default 4000).
PORT=4000

# Public URL of the Vercel frontend — used for payment redirects.
FRONTEND_URL=https://your-app.vercel.app

# Comma-separated allowed origins for CORS.
CORS_ORIGIN=https://your-app.vercel.app,http://localhost:3000

# --- Supabase (required) — Settings → API ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxxxxxxx
# Must be a verified domain/sender in Resend.
EMAIL_FROM=Trike Nation <orders@trike-nation.com>
# Where contact-form notifications are delivered.
ADMIN_EMAIL=support@trike-nation.com

# --- Stripe (hosted Checkout) ---
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
# Signing secret of the webhook endpoint pointed at /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- PayPal Business (Orders v2 REST) ---
PAYPAL_CLIENT_ID=your-client-id
PAYPAL_CLIENT_SECRET=your-client-secret
# sandbox (default) or live
PAYPAL_ENV=live
