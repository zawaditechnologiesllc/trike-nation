{
  "$schema": "../../frontend/node_modules/wrangler/config-schema.json",
  "name": "gocartgrip-cron",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "observability": { "enabled": true },
  "triggers": {
    // Every 15 minutes. Each sweep claims an order_events row before acting,
    // so overlapping runs cannot double-send and a frequent clock costs
    // nothing. A missed run is caught up by the next one, and dueStage returns
    // the LAST due stage, so even a long outage produces one email per order
    // rather than a burst.
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    // Backend base URL, no trailing slash.
    "API_URL": "https://gocartgrip-api.onrender.com"
  }
  // CRON_SECRET is a secret, not a var:
  //   npx wrangler secret put CRON_SECRET --config workers/cron/wrangler.jsonc
}
