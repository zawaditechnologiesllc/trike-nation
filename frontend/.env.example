# Copy to .env.local for local development.
# For production, set the same variables in Vercel:
#   Project → Settings → Environment Variables (then REDEPLOY —
#   NEXT_PUBLIC_* values are baked in at build time).

# Base URL of the backend API (the Render service). No trailing slash.
# Local dev: http://localhost:4000
NEXT_PUBLIC_API_URL=https://trike-nation-api.onrender.com

# Supabase project → Settings → API. The anon key is safe to expose;
# never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
